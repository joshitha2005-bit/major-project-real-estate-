# General Configuration
PROJECT_NAME="GeoSmart Price AI — Real Estate Price Prediction & GIS Platform"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL in production / SQLite fallback for local demo)
DATABASE_URL="sqlite:///./real_estate.db"

# JWT Auth Security Configuration
JWT_SECRET="YOUR_JWT_SECRET_KEY_HERE"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Geoapify GIS API Key (Obtain from https://myprojects.geoapify.com/)
GEOAPIFY_API_KEY="YOUR_GEOAPIFY_API_KEY_HERE"

# Frontend API URL
VITE_API_URL="http://localhost:8000/api/v1"

# Google Maps API Configuration (Optional)
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"
