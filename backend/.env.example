# Backend Environment Configuration

PROJECT_NAME="Real Estate Price Prediction & GIS Platform"
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL="sqlite:///./real_estate.db"

# Security
JWT_SECRET="YOUR_JWT_SECRET_KEY_HERE"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Geoapify GIS API Key
GEOAPIFY_API_KEY="YOUR_GEOAPIFY_API_KEY_HERE"

# ==============================================================================
# Google Gemini Live AI Configuration
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
# ==============================================================================
GEMINI_API_KEY=""
GEMINI_LIVE_MODEL="gemini-2.0-flash-exp"

# ==============================================================================
# Twilio Programmable Voice Configuration (Real Outbound Telephone Calls)
# 1. Sign up / log in to Twilio Console: https://console.twilio.com/
# 2. Account SID: 34 characters starting with 'AC'
# 3. Auth Token: 32 hex characters directly under Account SID
# 4. Phone Number: Active Twilio phone number in E.164 format (e.g. +12025550199)
# Note: On a free Twilio trial account, your personal destination mobile must be
# verified in Twilio Console under 'Verified Caller IDs'.
# ==============================================================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ==============================================================================
# Public Base URL for Twilio Webhooks
# Twilio requires a publicly reachable HTTPS URL to deliver voice webhooks.
# Development: Start a tunnel with 'npx localtunnel --port 8000' or 'ngrok http 8000'
# Example: VOICE_PUBLIC_BASE_URL="https://your-tunnel-name.ngrok-free.app"
# ==============================================================================
VOICE_PUBLIC_BASE_URL="http://localhost:8000"

# Private Admin Configuration (Configurable environment secrets)
PRIVATE_ADMIN_EMAIL=admin@example.com
PRIVATE_ADMIN_PHONE=+919876543210
PRIVATE_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE
AUTO_SEND_HIGH_CONFIDENCE_LEADS=false
OWNER_NOTIFICATION_PROVIDER=

# ==============================================================================
# Razorpay Payment Gateway Configuration (PropPulse Pro Subscription)
# 1. Sign up / log in to Razorpay Dashboard: https://dashboard.razorpay.com/
# 2. Go to Settings -> API Keys -> Generate Key
# 3. RAZORPAY_KEY_ID: Starts with 'rzp_test_' or 'rzp_live_'
# 4. RAZORPAY_KEY_SECRET: Generated along with key ID
# 5. RAZORPAY_WEBHOOK_SECRET: Configured under Settings -> Webhooks
# ==============================================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
